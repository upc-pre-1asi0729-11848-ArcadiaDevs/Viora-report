@startuml VioraLandingComponents
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - Landing Page

Person(visitor, "Visitor", "Explores Viora's landing page, plans, testimonials and calls to action.")

Container_Boundary(landingPage, "Landing Page") {
    Component(landingPageHeader, "Landing Header Component", "ES Module / DOM Controller", "Provides the landing header navigation, scrolling behaviors, and segment-switching trigger.")
    Component(hero, "Hero Section Component", "ES Module / DOM Controller", "Presents the core value proposition, manages background movements, and delegates ambient audio triggering.")
    Component(interactiveAudio, "Interactive Audio Module", "ES Module / Audio Service", "Manages audio playback toggle and plays background ambient audio depending on the current section.")
    Component(visualEffects, "Visual Effects Component", "ES Module / Canvas & CSS Effects", "Applies custom visual filters and interactives such as liquid-glass rendering and magnetic pull to UI elements.")
    Component(i18n, "i18n Localization Component", "ES Module / Localization Service", "Fetches multilinguistic translations from JSON files and injects translations dynamically into DOM elements.")
    Component(sectionPanels, "Section Panels Controllers", "ES Module / DOM Controller", "Orchestrates direct DOM updates and event handling for individual content sections (About, Pricing, Expected Outcomes, Team, Referrals, etc.).")
    Component(footer, "Footer Section Component", "ES Module / DOM Controller", "Controls links structure, interactive content, and rendering within the website's footer.")
}

Container(webApp, "Web Application", "Angular", "Single-page application used by olive producers and agricultural specialists to manage plots, alerts, interventions and subscriptions.")

Rel(visitor, landingPageHeader, "Interacts with header navigation")
Rel(visitor, hero, "Views hero value proposition and CTAs")
Rel(visitor, sectionPanels, "Interacts with visual section panels")
Rel(visitor, footer, "Navigates footer links")

Rel(landingPageHeader, i18n, "Retrieves header translations from")
Rel(hero, i18n, "Retrieves hero translations from")
Rel(sectionPanels, i18n, "Retrieves section translations from")
Rel(footer, i18n, "Retrieves footer translations from")

Rel(hero, interactiveAudio, "Triggers hero audio triggers through")
Rel(sectionPanels, interactiveAudio, "Triggers panel sound cues through")

Rel(landingPageHeader, visualEffects, "Applies scroll effects and transitions via")
Rel(hero, visualEffects, "Applies background parallax via")
Rel(sectionPanels, visualEffects, "Applies magnetic and sound hover behaviors via")

Rel(hero, webApp, "Redirects visitors to sign-in or trial flows in")
Rel(sectionPanels, webApp, "Redirects visitors to sign-in or trial flows in")

SHOW_LEGEND()
@enduml
